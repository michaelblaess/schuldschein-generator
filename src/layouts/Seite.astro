---
import '@fontsource/barlow-semi-condensed/400.css';
import '@fontsource/barlow-semi-condensed/500.css';
import '@fontsource/barlow-semi-condensed/600.css';
import '@fontsource/barlow-semi-condensed/700.css';
import '@fontsource/barlow-semi-condensed/400-italic.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import Einwilligung from '../components/Einwilligung.astro';
import Fuss from '../components/Fuss.astro';
import Kopf from '../components/Kopf.astro';
import { DOMAIN, PFADE, t, type SeitenSchluessel, type Sprache } from '../lib/i18n';

interface Props {
  sprache: Sprache;
  /** null nur fuer die Fehlerseite, die keine Sprachentsprechung und keine kanonische Adresse hat. */
  seite: SeitenSchluessel | null;
  titel: string;
  beschreibung: string;
  mitLeiste?: boolean;
}
const { sprache, seite, titel, beschreibung, mitLeiste = false } = Astro.props;
const marke = t(sprache, 'marke');
// Marke zentral anhaengen, damit keine Seite sie vergisst und keine sie doppelt traegt
const volltitel = titel.includes(marke) ? titel : `${titel} - ${marke}`;
const kanonisch = seite ? `${DOMAIN}${PFADE[seite][sprache]}` : null;
const bild = `${DOMAIN}/og.png`;
---
<!doctype html>
<html lang={sprache}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{volltitel}</title>
    <meta name="description" content={beschreibung} />
    {kanonisch && <link rel="canonical" href={kanonisch} />}
    {seite && (
      <>
        <link rel="alternate" hreflang="de" href={`${DOMAIN}${PFADE[seite].de}`} />
        <link rel="alternate" hreflang="en" href={`${DOMAIN}${PFADE[seite].en}`} />
        <link rel="alternate" hreflang="x-default" href={`${DOMAIN}${PFADE[seite].de}`} />
      </>
    )}
    {!seite && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={marke} />
    <meta property="og:title" content={volltitel} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:image" content={bild} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={sprache === 'de' ? 'de_DE' : 'en_GB'} />
    {kanonisch && <meta property="og:url" content={kanonisch} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#C8102E" />
    <script is:inline>
      // Gewaehltes Design vor dem ersten Bild setzen, sonst blitzt die Seite hell auf
      try {
        var gewaehlt = localStorage.getItem('thema');
        if (gewaehlt === 'light' || gewaehlt === 'dark') {
          document.documentElement.setAttribute('data-theme', gewaehlt);
        }
      } catch (e) {
        // ohne Speicher gilt das System
      }
    </script>
    <Einwilligung sprache={sprache} />
  </head>
  <body class:list={{ 'mit-leiste': mitLeiste }}>
    <a class="skip" href="#inhalt">{t(sprache, 'skip')}</a>
    <Kopf sprache={sprache} seite={seite} />
    <main id="inhalt" class="rahmen-breite inhalt-haupt">
      <slot />
    </main>
    <Fuss sprache={sprache} />
    <slot name="danach" />
  </body>
</html>
