---
const { title = 'Schuldschein-Generator' } = Astro.props;
import "../styles/global.css";
const pathname = Astro.url.pathname;
const isEn = pathname.startsWith('/en');
const langPrefix = isEn ? '/en' : '';
---
<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>

    <!-- External Libraries -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

    <!-- i18n (global) -->
    <script src="/translations/de-de.js" is:inline></script>
    <script src="/translations/en-us.js" is:inline></script>
    <script src="/js/TranslationController.js" is:inline></script>

    <!-- Custom Styles -->
    <link rel="stylesheet" href="/css/styles.css" />

    <link rel="icon" href="/favicon.ico" />
  </head>
  <body>
    <!-- Navbar -->
    <header class="border-b bg-base-200 no-print relative z-40 overflow-visible">
      <div class="page-wrap px-4 md:px-6">
        <div class="navbar px-0 overflow-visible">
        <!-- START: Hamburger + Title -->
        <div class="navbar-start gap-2 items-center">
          <div class="dropdown">
            <button tabindex="0" class="btn btn-ghost btn-lg text-xl px-4" aria-label="Menü">☰</button>
            <ul tabindex="0" class="menu menu-sm dropdown-content mt-3 z-50 p-2 shadow bg-base-100 rounded-box w-64">
              <li><a href={`${langPrefix}/`} data-i18n="nav-generator">Generator</a></li>
              <li><a href={`${langPrefix}/about`} data-i18n="nav-about">Über</a></li>
              <li><a href={`${langPrefix}/impressum`} data-i18n="nav-impressum">Impressum</a></li>
              <li><a href={`${langPrefix}/datenschutz`} data-i18n="nav-privacy">Datenschutz</a></li>
              <li><a href={`${langPrefix}/nutzungsbedingungen`} data-i18n="nav-terms">Nutzungsbedingungen</a></li>
            </ul>
          </div>
          <div class="flex flex-col">
            <div class="flex items-center gap-2">
              <a href={`${langPrefix}/`} id="header-title" data-i18n="header-title" class="text-base font-semibold">Schuldschein-Generator</a>
              <span id="app-version" class="badge badge-neutral badge-sm">v0.2.0</span>
            </div>
            <div id="header-subtitle" data-i18n="header-subtitle" class="text-xs opacity-70 hidden sm:block">Privater Schuldschein in 2 Minuten als PDF</div>
          </div>
        </div>

        <!-- CENTER: empty (keine Titel-Duplikation) -->
        <div class="navbar-center"></div>

        <!-- END: Theme Toggle, Language, GitHub -->
        <div class="navbar-end items-center gap-1 sm:gap-2">
          <!-- Theme Toggle (light/dracula) -->
          <label class="flex items-center cursor-pointer gap-2 tooltip tooltip-bottom" data-tip="Theme umschalten">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="5" />
              <path d="M12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4" />
            </svg>
            <input id="themeToggle" type="checkbox" value="dracula" class="toggle toggle-primary toggle-sm" aria-label="Theme umschalten" />
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </label>

          <!-- Language Toggle Placeholder (optional, statisch) -->
          <label id="languageToggle" class="flex items-center cursor-pointer gap-2 tooltip tooltip-bottom px-2" data-tip="Sprache wechseln">
            <span class="text-xs leading-none">DE</span>
            <input type="checkbox" class="toggle toggle-secondary toggle-sm" aria-label="Sprache umschalten">
            <span class="text-xs leading-none">EN</span>
          </label>

          <!-- GitHub -->
          <a href="https://github.com/michaelblaess/schuldschein-generator" class="btn btn-ghost btn-sm btn-square tooltip tooltip-bottom flex items-center justify-center p-0" data-tip="GitHub Repository" target="_blank" rel="noopener noreferrer" aria-label="GitHub Repository">
            <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" class="w-4 h-4 fill-current block">
              <path d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
            </svg>
          </a>
        </div>
        </div>
      </div>
    </header>

    <!-- Privacy Notice -->
    <div class="page-wrap px-4 mt-4 no-print">
      <div class="alert alert-info">
        <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M12 2a10 10 0 100 20 10 10 0 000-20z" />
        </svg>
        <div class="text-sm">
          <span class="font-semibold"><span data-i18n="privacy-label">Datenschutzhinweis</span>:</span>
          <span id="privacy-notice" data-i18n="privacy-notice-text">Alle Eingaben bleiben ausschließlich in Ihrem Browser. Es werden keine Daten übertragen oder gespeichert.</span>
        </div>
      </div>
    </div>

    <slot />

    <!-- Footer -->
    <footer class="mt-12 no-print">
      <!-- Full-width footer navigation like navbar -->
      <div class="footer sm:footer-horizontal bg-base-200 text-base-content p-10 justify-center">
        <nav class="mx-4">
          <h6 class="footer-title" data-i18n="footer-title-project">Projekt</h6>
          <a class="link link-hover" href={`${langPrefix}/`} data-i18n="nav-generator">Generator</a>
          <a class="link link-hover" href={`${langPrefix}/about`} data-i18n="nav-about">Über</a>
        </nav>
        <nav class="mx-4">
          <h6 class="footer-title" data-i18n="footer-title-legal">Rechtliches</h6>
          <a class="link link-hover" href={`${langPrefix}/nutzungsbedingungen`} data-i18n="nav-terms">Nutzungsbedingungen</a>
          <a class="link link-hover" href={`${langPrefix}/datenschutz`} data-i18n="nav-privacy">Datenschutz</a>
          <a class="link link-hover" href={`${langPrefix}/impressum`} data-i18n="nav-impressum">Impressum</a>
        </nav>
        <nav class="mx-4">
          <h6 class="footer-title" data-i18n="footer-title-contact">Kontakt</h6>
          <a class="link link-hover" href="mailto:info@schuldschein-generator.de">info@schuldschein-generator.de</a>
          <a class="link link-hover" href="https://github.com/michaelblaess/schuldschein-generator" target="_blank" rel="noopener noreferrer">GitHub</a>
        </nav>
        <div class="mt-6 w-full text-center flex flex-col items-center gap-1">
          <p id="footer-disclaimer" data-i18n="footer-disclaimer" class="text-xs sm:text-sm font-semibold">Keine Rechtsberatung • Keine Datenspeicherung • Mustervorlage ohne Gewähr</p>
          <p class="text-xs opacity-80">
            <span data-i18n="footer-license-text">Apache-2.0 • siehe</span>
            <span class="ml-1">
              <a class="link link-hover" href="https://github.com/michaelblaess/schuldschein-generator/blob/main/LICENSE" target="_blank" rel="noopener noreferrer">LICENSE</a>
              <span> / </span>
              <a class="link link-hover" href="https://github.com/michaelblaess/schuldschein-generator/blob/main/NOTICE" target="_blank" rel="noopener noreferrer">NOTICE</a>
            </span>
          </p>
          <p id="footer-copyright" data-i18n="footer-copyright" class="text-xs opacity-80">© 2025 Online-Schuldschein-Generator</p>
          <p class="text-xs opacity-80 flex items-center gap-2">
            <span>✝</span>
            <span data-i18n="footer-quote">"Du kannst immer geben, ohne zu lieben. Aber du kannst niemals lieben, ohne zu geben." - Amy Carmichael</span>
          </p>
        </div>
      </div>
    </footer>

    <script>
      // Minimal Theme Toggle (ohne Abhängigkeit von common.js)
      const root = document.documentElement;
      const savedTheme = localStorage.getItem('theme') || 'light';
      root.setAttribute('data-theme', savedTheme);
      const themeToggle = document.getElementById('themeToggle');
      if (themeToggle) {
        themeToggle.checked = (savedTheme === 'dracula');
        themeToggle.addEventListener('change', () => {
          const newTheme = themeToggle.checked ? 'dracula' : 'light';
          root.setAttribute('data-theme', newTheme);
          localStorage.setItem('theme', newTheme);
        });
      }

      // Global i18n init + apply for all pages (Navbar, Footer, static pages)
      (function(){
        if (!window.TranslationController) return;
        window.translation = window.translation || new TranslationController();
        // Determine locale from path prefix
        const isEnPath = location.pathname.startsWith('/en');
        const desired = isEnPath ? 'en-US' : 'de-DE';
        // Initialize/set locale
        const currentInit = window.translation.init();
        if (currentInit !== desired) {
          window.translation.setLocale(desired);
        }
        const langToggle = document.getElementById('languageToggle');
        const langCheckbox = langToggle ? langToggle.querySelector('input[type="checkbox"]') : null;
        if (langCheckbox) {
          langCheckbox.checked = (desired === 'en-US');
          langCheckbox.addEventListener('change', () => {
            const goingEn = langCheckbox.checked;
            const p = location.pathname;
            const newPath = goingEn ? (p.startsWith('/en') ? p : ('/en' + (p === '/' ? '/' : p)))
                                    : (p.startsWith('/en') ? (p.replace(/^\/en/, '') || '/') : p);
            // Force locale and navigate to keep routes + SSR content in sync
            window.translation.setLocale(goingEn ? 'en-US' : 'de-DE');
            window.translation.apply(document);
            location.href = newPath + location.search + location.hash;
          });
        }
        window.addEventListener('translation:change', () => {
          window.translation.apply(document);
        });
        // Initial apply for SSR markup
        window.translation.apply(document);
      })();
    </script>
  </body>
  </html>
